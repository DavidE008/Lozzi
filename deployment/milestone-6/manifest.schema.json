{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lozzi.example/schemas/milestone-6/deployment-manifest.v1.schema.json",
  "title": "Lozzi Milestone 6 deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "approvalStatus",
    "pinnedSourceCommit",
    "chainConfigPath",
    "bytecodeFingerprintPath",
    "simulationReportPath",
    "compiler",
    "contracts",
    "governance",
    "relayer",
    "funding",
    "transactionBatch",
    "approval"
  ],
  "properties": {
    "schemaVersion": {
      "const": "lozzi.m6.deployment.v1"
    },
    "approvalStatus": {
      "enum": ["unapproved", "approved"]
    },
    "pinnedSourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "chainConfigPath": {
      "const": "deployment/milestone-6/chain-config.template.json"
    },
    "bytecodeFingerprintPath": {
      "const": "deployment/milestone-6/bytecode-fingerprints.json"
    },
    "simulationReportPath": {
      "const": "deployment/milestone-6/simulation-report.template.json"
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solcVersion",
        "evmVersion",
        "optimizerEnabled",
        "optimizerRuns"
      ],
      "properties": {
        "solcVersion": {
          "const": "0.8.30"
        },
        "evmVersion": {
          "const": "cancun"
        },
        "optimizerEnabled": {
          "const": true
        },
        "optimizerRuns": {
          "const": 200
        }
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/contract"
      }
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "relayer": {
      "$ref": "#/$defs/relayer"
    },
    "funding": {
      "$ref": "#/$defs/funding"
    },
    "transactionBatch": {
      "$ref": "#/$defs/transactionBatch"
    },
    "approval": {
      "$ref": "#/$defs/approval"
    }
  },
  "$defs": {
    "nullableAddress": {
      "type": ["string", "null"],
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "nullableHash": {
      "type": ["string", "null"],
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "nullableDecimal": {
      "type": ["string", "null"],
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "expectedAddress",
        "creationBytecodeKeccak256",
        "expectedRuntimeBytecodeKeccak256",
        "constructorArguments"
      ],
      "properties": {
        "name": {
          "enum": ["InstitutionRegistry", "AcademicRecordRegistry"]
        },
        "source": {
          "type": "string"
        },
        "expectedAddress": {
          "$ref": "#/$defs/nullableAddress"
        },
        "creationBytecodeKeccak256": {
          "$ref": "#/$defs/nullableHash"
        },
        "expectedRuntimeBytecodeKeccak256": {
          "$ref": "#/$defs/nullableHash"
        },
        "constructorArguments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "value"],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "const": "address"
              },
              "value": {
                "$ref": "#/$defs/nullableAddress"
              }
            }
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safeAddress",
        "safeOwners",
        "safeThreshold",
        "deployerAddress",
        "institutionAdministrator",
        "institutionSigner",
        "emergencyOwner"
      ],
      "properties": {
        "safeAddress": {
          "$ref": "#/$defs/nullableAddress"
        },
        "safeOwners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nullableAddress"
          }
        },
        "safeThreshold": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "deployerAddress": {
          "$ref": "#/$defs/nullableAddress"
        },
        "institutionAdministrator": {
          "$ref": "#/$defs/nullableAddress"
        },
        "institutionSigner": {
          "$ref": "#/$defs/nullableAddress"
        },
        "emergencyOwner": {
          "$ref": "#/$defs/nullableAddress"
        }
      }
    },
    "relayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "provider",
        "allowedChainId",
        "allowedContract",
        "allowedMethods",
        "maxValueWei",
        "maxGasPerTransaction",
        "dailyFundingCeilingWei"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/nullableAddress"
        },
        "provider": {
          "type": ["string", "null"]
        },
        "allowedChainId": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "allowedContract": {
          "$ref": "#/$defs/nullableAddress"
        },
        "allowedMethods": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "publishRecordVersion",
              "createShareGrant",
              "revokeShareGrant"
            ]
          }
        },
        "maxValueWei": {
          "$ref": "#/$defs/nullableDecimal"
        },
        "maxGasPerTransaction": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "dailyFundingCeilingWei": {
          "$ref": "#/$defs/nullableDecimal"
        }
      }
    },
    "funding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentFundingCeilingWei",
        "maximumBatchGas",
        "maximumFeePerGasWei",
        "maximumPriorityFeePerGasWei",
        "maximumTotalCostWei"
      ],
      "properties": {
        "deploymentFundingCeilingWei": {
          "$ref": "#/$defs/nullableDecimal"
        },
        "maximumBatchGas": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "maximumFeePerGasWei": {
          "$ref": "#/$defs/nullableDecimal"
        },
        "maximumPriorityFeePerGasWei": {
          "$ref": "#/$defs/nullableDecimal"
        },
        "maximumTotalCostWei": {
          "$ref": "#/$defs/nullableDecimal"
        }
      }
    },
    "transactionBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batchId", "approvalRequired", "transactions"],
      "properties": {
        "batchId": {
          "type": ["string", "null"]
        },
        "approvalRequired": {
          "const": true
        },
        "transactions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sequence",
              "action",
              "target",
              "valueWei",
              "calldataKeccak256",
              "gasLimit",
              "approvalId"
            ],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "action": {
                "type": "string"
              },
              "target": {
                "$ref": "#/$defs/nullableAddress"
              },
              "valueWei": {
                "$ref": "#/$defs/nullableDecimal"
              },
              "calldataKeccak256": {
                "$ref": "#/$defs/nullableHash"
              },
              "gasLimit": {
                "type": ["integer", "null"],
                "minimum": 1
              },
              "approvalId": {
                "type": ["string", "null"]
              }
            }
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "packetId",
        "preparedBy",
        "independentReviewer",
        "approvers",
        "approvedAt",
        "expiresAt"
      ],
      "properties": {
        "status": {
          "enum": ["unapproved", "approved"]
        },
        "packetId": {
          "type": ["string", "null"]
        },
        "preparedBy": {
          "type": ["string", "null"]
        },
        "independentReviewer": {
          "type": ["string", "null"]
        },
        "approvers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approvedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "expiresAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  }
}
